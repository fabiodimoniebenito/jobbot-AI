# Copia este archivo como ".env" (sin .example) y rellénalo. NO lo subas a GitHub.
ANTHROPIC_API_KEY=sk-ant-...
GMAIL_USER=
# Contraseña de aplicación de Google (16 letras), NO tu contraseña normal
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Etiqueta de Gmail donde entran las alertas de empleo
ALERT_LABEL=ofertas
# Puntuación mínima (0-100) para preparar borrador
MIN_SCORE=55
# Modelo para extraer y puntuar ofertas (barato) y para redactar CV y carta (mejor redacción)
# SCORE_MODEL=claude-haiku-5-5
# CLAUDE_MODEL=claude-sonnet-5-5
# Proveedor del modelo: "anthropic" (por defecto) o "ollama" (local, sin coste de API)
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
# Con ollama, SCORE_MODEL y CLAUDE_MODEL son nombres de modelo de Ollama (ollama pull qwen2.5:14b)
# SCORE_MODEL=qwen2.5:7b
# CLAUDE_MODEL=qwen2.5:14b
